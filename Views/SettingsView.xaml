<UserControl x:Class="Win11TaskMan.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Win11TaskMan.Views"
             Background="#1E1E1E" Foreground="#FFFFFF" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6E6E6"/><Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/><Setter Property="Margin" Value="0,6"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>

            <TextBlock Text="Real time update speed" Style="{StaticResource Section}"/>
            <RadioButton x:Name="SpeedHigh" GroupName="speed" Content="High (0.5 s)" Checked="Speed_Checked"/>
            <RadioButton x:Name="SpeedNormal" GroupName="speed" Content="Normal (1 s)" IsChecked="True" Checked="Speed_Checked"/>
            <RadioButton x:Name="SpeedLow" GroupName="speed" Content="Low (4 s)" Checked="Speed_Checked"/>
            <RadioButton x:Name="SpeedPaused" GroupName="speed" Content="Paused" Checked="Speed_Checked"/>

            <TextBlock Text="Default starting page" Style="{StaticResource Section}"/>
            <ComboBox x:Name="DefaultPage" Width="220" HorizontalAlignment="Left" SelectedIndex="0"
                      SelectionChanged="DefaultPage_Changed">
                <ComboBoxItem Content="Processes"/>
                <ComboBoxItem Content="Performance"/>
                <ComboBoxItem Content="Startup apps"/>
                <ComboBoxItem Content="Users"/>
                <ComboBoxItem Content="Details"/>
                <ComboBoxItem Content="Services"/>
            </ComboBox>

            <TextBlock Text="Window management" Style="{StaticResource Section}"/>
            <CheckBox x:Name="AlwaysOnTop" Content="Always on top" Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"/>

            <TextBlock Text="Default Task Manager" Style="{StaticResource Section}"/>
            <CheckBox x:Name="ReplaceTaskMgr" Content="Replace the built-in Windows Task Manager with this app"
                      Checked="ReplaceTaskMgr_Changed" Unchecked="ReplaceTaskMgr_Changed"/>
            <TextBlock x:Name="ReplaceNote" Foreground="#A8A8A8" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                       Text="When on, Ctrl+Shift+Esc, the taskbar menu and Ctrl+Alt+Del open this app instead of the Windows Task Manager. Changing this needs administrator rights."/>

            <TextBlock Text="Privileges" Style="{StaticResource Section}"/>
            <TextBlock x:Name="AdminNote" Foreground="#A8A8A8" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="CPU temperature and full service/startup control need administrator rights."/>
            <CheckBox x:Name="AlwaysAdmin" Content="Always run as administrator"
                      Checked="AlwaysAdmin_Changed" Unchecked="AlwaysAdmin_Changed"/>
            <TextBlock Foreground="#A8A8A8" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                       Text="The app will request elevation each time it starts. Windows shows a User Account Control prompt on every launch."/>
            <Button x:Name="AdminBtn" Style="{StaticResource ToolButton}" Click="RunAsAdmin_Click"
                    HorizontalAlignment="Left" Background="#2B2B2B">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0"/>
                    <TextBlock Text="Run as administrator"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Developer" Style="{StaticResource Section}"/>
            <TextBlock Foreground="#A8A8A8" TextWrapping="Wrap" Text="P3k"/>

            <TextBlock Text="About" Style="{StaticResource Section}"/>
            <TextBlock Foreground="#A8A8A8" TextWrapping="Wrap"
                       Text="Win11 Task Manager clone — WPF / .NET 8. Live metrics via NtQuerySystemInformation, GetSystemTimes, physical-disk IOCTLs, GetIfTable2 and PDH GPU counters."/>
                       
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
