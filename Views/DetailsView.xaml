<UserControl x:Class="Win11TaskMan.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Win11TaskMan.Views"
             Background="#1E1E1E" Foreground="#FFFFFF" FontSize="13">

    <UserControl.Resources>
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="56" Margin="20,0,16,0">
            <TextBlock Text="Details" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="EndTaskBtn" Style="{StaticResource ToolButton}" Click="EndTask_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center" IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0"/>
                    <TextBlock Text="End task"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border DockPanel.Dock="Top" Margin="20,0,16,8" Background="#2B2B2B" CornerRadius="5"
                Width="300" HorizontalAlignment="Left">
            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="White"
                     BorderThickness="0" Padding="10,6" VerticalContentAlignment="Center"
                     TextChanged="Search_Changed"/>
        </Border>

        <DataGrid x:Name="Grid" CanUserSortColumns="True" Sorting="Grid_Sorting"
                  SelectionChanged="Grid_SelectionChanged" MouseRightButtonUp="Grid_RightClick"
                  Margin="12,0,0,0">
            <DataGrid.Resources>
                <ContextMenu x:Key="RowMenu">
                    <MenuItem Header="End task" Click="EndTask_Click"/>
                    <MenuItem Header="Set priority">
                        <MenuItem Header="Realtime" Tag="256" Click="Priority_Click"/>
                        <MenuItem Header="High" Tag="128" Click="Priority_Click"/>
                        <MenuItem Header="Above normal" Tag="32768" Click="Priority_Click"/>
                        <MenuItem Header="Normal" Tag="32" Click="Priority_Click"/>
                        <MenuItem Header="Below normal" Tag="16384" Click="Priority_Click"/>
                        <MenuItem Header="Low" Tag="64" Click="Priority_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Open file location" Click="OpenLocation_Click"/>
                    <MenuItem Header="Search online" Click="SearchOnline_Click"/>
                    <MenuItem Header="Properties" Click="Properties_Click"/>
                </ContextMenu>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#262626"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" SortMemberPath="Name"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" SortMemberPath="Pid"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" SortMemberPath="Status"/>
                <DataGridTextColumn Header="User name" Binding="{Binding UserName}" Width="130" SortMemberPath="UserName"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="70" SortMemberPath="Cpu"
                                    ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemText}" Width="110" SortMemberPath="MemBytes"
                                    ElementStyle="{StaticResource NumCell}"/>
                <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="100" SortMemberPath="Architecture"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" SortMemberPath="Description"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
